# Frontend: public server URLs only. Never expose provider keys in Vite variables.
VITE_AI_API_URL=https://your-api.example.com/api/research
VITE_PLATFORM_API_URL=https://your-api.example.com

# Backend: configure these as encrypted secrets on the server host.
AI_API_KEY=
AI_PROVIDER=OpenAI
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_API_MODE=chat-completions
AI_REASONING_EFFORT=

# Web research used by every PathPilot tool. Keep this server-side only.
TAVILY_API_KEY=

# Account email verification + password reset.
RESEND_API_KEY=
EMAIL_FROM=PathPilot <noreply@your-verified-domain.com>
PUBLIC_APP_URL=https://abdelrhmanmaroxo-spec.github.io/pathpilot-ai/

# Optional Google sign-in.
GOOGLE_CLIENT_ID=

# Owner and security.
OWNER_EMAIL=
ALLOWED_ORIGINS=https://abdelrhmanmaroxo-spec.github.io,http://localhost:5173
DATABASE_PATH=/data/pathpilot.sqlite
PORT=8787
