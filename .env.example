# ============================================================================
# PathPilot AI v5.0 — 100% Free Cloud & Official Email Configuration
# Zero Railway Required! Works completely free on GitHub Pages + Gmail Bridge
# ============================================================================

# Frontend Build Variables (GitHub Pages / Vite)
# Leave VITE_PLATFORM_API_URL empty to use the built-in 100% Free Cloud Hub + Google Apps Script Bridge!
VITE_PLATFORM_API_URL=
VITE_AI_API_URL=
# Paste your free Google Apps Script Web App URL (from pathpilot.app00@gmail.com) here or inside Owner Settings UI:
VITE_FREE_CLOUD_URL=
VITE_OWNER_EMAIL=Abdelrhman.maroxo@gmail.com
VITE_SUPPORT_EMAIL=pathpilot.app00@gmail.com
VITE_AI_TIMEOUT_MS=68000

# ============================================================================
# Optional Self-Hosted / Free Node Backend Settings (Local / Render Free / Koyeb)
# ============================================================================
PORT=8787
DATABASE_PATH=server/data/pathpilot.sqlite
ALLOWED_ORIGINS=http://localhost:5173,https://abdelrhmanmaroxo-spec.github.io
PUBLIC_APP_URL=https://abdelrhmanmaroxo-spec.github.io/pathpilot-ai/

# Protected Owner Account & Official Support Mailbox
OWNER_EMAIL=Abdelrhman.maroxo@gmail.com
SUPPORT_EMAIL=pathpilot.app00@gmail.com

# Free Gmail SMTP (Recommended for Node server: create a 16-char Google App Password on pathpilot.app00@gmail.com)
EMAIL_PROVIDER=gmail
EMAIL_FROM="PathPilot <pathpilot.app00@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=pathpilot.app00@gmail.com
SMTP_PASS=

# Optional Gmail API OAuth2 Alternative
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional Resend Alternative
RESEND_API_KEY=

# Optional Google Sign-In
GOOGLE_CLIENT_ID=

# Optional Free AI Provider (e.g. Google AI Studio Gemini Free Tier)
AI_PROVIDER=Gemini
AI_API_MODE=chat-completions
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_REASONING_EFFORT=
TAVILY_API_KEY=
